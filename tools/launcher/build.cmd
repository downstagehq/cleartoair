@echo off
REM Builds "Clear to Air.exe" with the C# compiler that ships with Windows.
REM No SDK, no NuGet. Output: tools\launcher\out\Clear to Air.exe
setlocal
cd /d "%~dp0"
set CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe
if not exist "%CSC%" set CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe
if not exist "%CSC%" (
  echo   csc.exe not found - .NET Framework 4.x is part of Windows 10/11, so this should not happen.
  exit /b 1
)
if not exist out mkdir out
REM ReleaseKey.cs is the public half of the release signing key, generated by
REM node tools\release-key.mjs generate. Without it the launcher cannot check updates.
if not exist ReleaseKey.cs (
  echo   ReleaseKey.cs missing - run: node tools\release-key.mjs generate
  exit /b 1
)
if exist icon.ico (set ICON=/win32icon:icon.ico) else (set ICON=)
REM Tray lamp: one PNG of the logo's mark per state and size, embedded by file name.
set RES=
for %%f in (brand\tray-*.png) do call set RES=%%RES%% /resource:"brand\%%~nxf",%%~nxf
"%CSC%" /nologo /target:winexe /optimize+ /out:"out\Clear to Air.exe" %ICON% %RES% ^
  /r:System.dll /r:System.Core.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll ^
  /r:System.IO.Compression.dll /r:System.IO.Compression.FileSystem.dll ^
  ClearToAir.cs ReleaseKey.cs
if errorlevel 1 exit /b 1
echo   built out\Clear to Air.exe
endlocal
